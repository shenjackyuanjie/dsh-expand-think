{
  "name": "@shenjackyuanjie/dsh-expand-think",
  "version": "0.3.3",
  "description": "thinking 输出时自动展开，结束后自动收起，保留手动查看；启停由 DSH 插件管理器管理。",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shenjackyuanjie/dsh-expand-think.git"
  },
  "homepage": "https://github.com/shenjackyuanjie/dsh-expand-think#readme",
  "bugs": {
    "url": "https://github.com/shenjackyuanjie/dsh-expand-think/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "patch-core.js",
    "settings.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "check": "node --check index.js && node --check patch-core.js && node --check settings.js && node --check client.js && node --check test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node test.mjs",
    "pack": "node -e \"require('node:fs').mkdirSync('dist',{recursive:true})\" && pnpm pack --ignore-scripts --pack-destination dist"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
